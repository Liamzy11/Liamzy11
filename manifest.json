{
    "manifest_version": 3,
    "name": "YouTube Music Dynamic UI",
    "version": "1.0",
    "description": "Changes YouTube Music background based on album art",
    "icons": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "permissions": ["scripting"],
    "host_permissions": ["https://music.youtube.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://music.youtube.com/*"],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ],
    "action": {}
  }